# NGLIP environment variables
# Copy to .env and fill in values before running.
# Never commit .env to git.

# Database
POSTGRES_PASSWORD=change_me_in_production

# Object storage (local path or S3-compatible URL)
OBJECT_STORE_PATH=/data
# OBJECT_STORE_BUCKET=nglip-rasters
# OBJECT_STORE_ENDPOINT=https://s3.example.com
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Ollama (narrative agent)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRY_HOURS=24

# Feature flags
FORECAST_ENABLED=false

# Backup (Phase 5)
# BACKUP_GPG_KEY=your_gpg_key_id
# BACKUP_RETENTION_DAYS=30
